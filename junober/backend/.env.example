# Copy to .env and edit for local dev. Never commit .env.
DEBUG=True
SECRET_KEY=replace-me-with-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# SQLite is the default. Uncomment and edit to use Postgres locally:
# DATABASE_URL=postgres://junober:junober@localhost:5432/junober

# Email — defaults to console backend (prints to stdout). In prod use SMTP/SES/SendGrid.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=replace-me
DEFAULT_FROM_EMAIL=JunOber <noreply@junober.dev>

# Frontend URL — used for absolute links in transactional emails (e.g. reset links)
FRONTEND_URL=http://localhost:5174

# Payments (Phase 3)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
