# ---------------------------------------------------------------------------
# Pass & Pay (Django) — environment variables
# Copy to `.env`. The app runs with NO changes on SQLite + mock integrations.
# ---------------------------------------------------------------------------

# Core
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=

# Database — leave unset to use SQLite (db.sqlite3). For PostgreSQL:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/passandpay

# Maps (optional). Without these the app renders a clean static route map.
MAPBOX_TOKEN=
GOOGLE_MAPS_API_KEY=

# Payments (optional, test mode). Without these, checkout runs in mock mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Production only
SECURE_SSL_REDIRECT=False
