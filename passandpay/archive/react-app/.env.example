# ---------------------------------------------------------------------------
# Pass & Pay — environment variables
#
# The app runs fully on seeded mock data with NO keys required. These vars are
# only needed if/when you wire in real third-party services. Copy this file to
# `.env` and fill in values. All client-exposed vars MUST be prefixed VITE_.
# ---------------------------------------------------------------------------

# Maps & routing (optional). If unset, the app renders a clean static route map.
VITE_MAPBOX_TOKEN=
VITE_GOOGLE_MAPS_API_KEY=

# Payments (optional, test mode). If unset, checkout runs in mock mode.
VITE_RAZORPAY_KEY_ID=
VITE_STRIPE_PUBLISHABLE_KEY=

# Backend (optional). If unset, data is stored in the browser (localStorage).
# To switch to Supabase, set these and implement the data layer in src/store.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
